# SundaySong local dev — copy to `.env` and adjust. Consumed by the API,
# workers, and the db tooling. The defaults match infra/dev/docker-compose.yml,
# so the stack works without an .env at all.

# Postgres (pgvector)
DATABASE_URL=postgres://sunday:sunday@localhost:5432/sundaysong
POSTGRES_USER=sunday
POSTGRES_PASSWORD=sunday
POSTGRES_DB=sundaysong

# Meilisearch (Phase 3.1 full-text search)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev_meili_master_key_change_me

# Redis (background jobs / sync queue)
REDIS_URL=redis://localhost:6379

# Anthropic (Phase 4 — translation drafts + recommendations)
ANTHROPIC_API_KEY=

# API
PORT=3001
# Web (points the browser SDK at the API)
NEXT_PUBLIC_API_URL=http://localhost:3001
